+    TEST_METHOD(ReflowDoesNotScrollCursorForTrailingWrappedBlankRows)
+    {
+        std::vector<TestRow> rows(30, { L"", true });
+        rows[0] = { L"header", false };
+        rows[1] = { L"copyright", false };
+        rows[2] = { L"", false };
+        rows[3] = { L"cmd>", true };
+
+        auto original = _textBufferFromTestBuffer({ { 80, 30 }, std::move(rows), { 5, 3 } });
+        auto resized = _textBufferByReflowingTextBuffer(*original, { 80, 27 });
+
+        VERIFY_ARE_EQUAL((til::point{ 5, 3 }), resized->GetCursor().GetPosition());
+        VERIFY_ARE_EQUAL(L'h', resized->GetRowByOffset(0).GlyphAt(0).front());
+        VERIFY_ARE_EQUAL(L'c', resized->GetRowByOffset(1).GlyphAt(0).front());
+        VERIFY_ARE_EQUAL(L'c', resized->GetRowByOffset(3).GlyphAt(0).front());
+    }
+
+    TEST_METHOD(ReflowPreservesInteriorWrappedWhitespaceBeforeText)
+    {
+        auto original = _textBufferFromTestBuffer({
+            { 6, 5 },
+            {
+                { L"AB    ", true },
+                { L"      ", true },
+                { L"CD    ", false },
+                { L"      ", true },
+                { L"      ", true },
+            },
+            { 2, 2 },
+        });
+        auto resized = _textBufferByReflowingTextBuffer(*original, { 6, 4 });
+
+        VERIFY_ARE_EQUAL((til::point{ 2, 2 }), resized->GetCursor().GetPosition());
+        VERIFY_ARE_EQUAL(L'A', resized->GetRowByOffset(0).GlyphAt(0).front());
+        VERIFY_ARE_EQUAL(L' ', resized->GetRowByOffset(0).GlyphAt(5).front());
+        VERIFY_ARE_EQUAL(true, resized->GetRowByOffset(0).WasWrapForced());
+        VERIFY_ARE_EQUAL(true, resized->GetRowByOffset(1).WasWrapForced());
+        VERIFY_ARE_EQUAL(L'C', resized->GetRowByOffset(2).GlyphAt(0).front());
+    }
+

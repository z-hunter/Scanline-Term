{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Scanline Term",
  "mainBinaryName": "sterm",
  "version": "0.1.5",
  "identifier": "com.zhunter.scanlineterm",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Scanline Term",
        "width": 1440,
        "height": 960,
        "resizable": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: https://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["msi"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "resources": {
      "resources/conpty/": "conpty/"
    },
    "windows": {
      "wix": {
        "fragmentPaths": ["wix/path.wxs"],
        "componentRefs": ["ScanlineTermPath"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEyMkNFOUFCQkRBRDIyM0IKUldRN0lxMjlxK2tzb21EdStHV0RmdlkxemYxVzVCNmNHc0ErK3NsbzRBenBrMG8zblIyZmRQOEsK",
      "endpoints": ["https://github.com/z-hunter/Scanline-Term/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}

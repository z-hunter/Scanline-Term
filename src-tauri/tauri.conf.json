{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Scanline Term",
  "version": "0.1.0",
  "identifier": "com.zhunter.scanlineterm",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Scanline Term",
        "width": 1440,
        "height": 960,
        "resizable": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "resources": {
      "resources/conpty/": "conpty/"
    }
  }
}
